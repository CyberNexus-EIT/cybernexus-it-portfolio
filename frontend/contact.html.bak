<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<meta
    name="description"
    content="CyberNexus IT Portfolio Platform — professional contact and communication."
>

<meta
    name="author"
    content="Mark C. Pangilinan"
>

<meta
    name="theme-color"
    content="#03070b"
>

<title>Contact | CyberNexus IT Portfolio Platform</title>

<link rel="stylesheet" href="css/theme.css">
<link rel="stylesheet" href="css/typography.css">
<link rel="stylesheet" href="css/spacing.css">
<link rel="stylesheet" href="css/layout.css">
<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/responsive.css">

</head><body
    class="app-shell"
    data-page="contact"
    data-section="overview"
><header
    class="site-header sticker"
    data-header
>

    <div class="header-inner">

        <a
            class="brand"
            href="portfolio.html"
            aria-label="CyberNexus Portfolio"
        >

            <span
                class="brand-mark"
                aria-hidden="true"
            >
                CN
            </span>

            <span class="brand-text">

                <span class="brand-name">
                    CyberNexus
                </span>

                <span class="brand-subtitle">
                    IT Portfolio Platform
                </span>

            </span>

        </a>

        <div
            class="status status-online"
            data-status
            aria-label="System status: Online"
        >

            <span
                class="status-indicator"
                aria-hidden="true"
            ></span>

            <span class="status-label">
                Online
            </span>

        </div>

        <nav
            class="page-nav"
            aria-label="Main navigation"
        >

            <ul class="page-nav-list">

                <li class="page-nav-item">
                    <a
                        class="page-nav-link"
                        href="portfolio.html"
                        data-page="portfolio"
                    >
                        Portfolio
                    </a>
                </li>

                <li class="page-nav-item">
                    <a
                        class="page-nav-link"
                        href="projects.html"
                        data-page="projects"
                    >
                        Projects
                    </a>
                </li>

                <li class="page-nav-item">
                    <a
                        class="page-nav-link"
                        href="skills.html"
                        data-page="skills"
                    >
                        Skills
                    </a>
                </li>

                <li class="page-nav-item">
                    <a
                        class="page-nav-link"
                        href="experience.html"
                        data-page="experience"
                    >
                        Experience
                    </a>
                </li>

                <li class="page-nav-item">
                    <a
                        class="page-nav-link is-current"
                        href="contact.html"
                        data-page="contact"
                        aria-current="page"
                    >
                        Contact
                    </a>
                </li>

                <li class="page-nav-item">
                    <a
                        class="page-nav-link"
                        href="privacy.html"
                        data-page="privacy"
                    >
                        Privacy
                    </a>
                </li>

                <li class="page-nav-item">
                    <a
                        class="page-nav-link"
                        href="terms.html"
                        data-page="terms"
                    >
                        Terms
                    </a>
                </li>

            </ul>

        </nav>

        <button
            class="button button-icon side-panel-toggle"
            type="button"
            data-side-panel-toggle
            aria-label="Toggle section panel"
            aria-controls="contact-side-panel"
            aria-expanded="true"
        >
            <span aria-hidden="true">☰</span>
        </button>

    </div>

</header>

<div class="app-body">

    <aside
        class="side-panel"
        id="contact-side-panel"
        data-side-panel
        aria-label="Contact sections"
    >

        <div class="side-panel-header">

            <div>

                <span class="eyebrow">
                    Contact
                </span>

                <h2 class="side-panel-title">
                    Sections
                </h2>

            </div>

            <button
                class="button button-icon"
                type="button"
                data-side-panel-toggle
                aria-label="Hide section panel"
                aria-controls="contact-side-panel"
                aria-expanded="true"
            >
                ×
            </button>

        </div>

        <nav
            class="side-nav"
            aria-label="Contact section navigation"
        >

            <ul class="side-nav-list">

                <li class="side-nav-item">

                    <a
                        class="side-nav-link is-current"
                        href="#overview"
                        data-section-link="overview"
                    >

                        <span class="side-nav-index">
                            01
                        </span>

                        <span>
                            Overview
                        </span>

                    </a>

                </li>

                <li class="side-nav-item">

                    <a
                        class="side-nav-link"
                        href="#contact-form"
                        data-section-link="contact-form"
                    >

                        <span class="side-nav-index">
                            02
                        </span>

                        <span>
                            Message
                        </span>

                    </a>

                </li>

                <li class="side-nav-item">

                    <a
                        class="side-nav-link"
                        href="#channels"
                        data-section-link="channels"
                    >

                        <span class="side-nav-index">
                            03
                        </span>

                        <span>
                            Channels
                        </span>

                    </a>

                </li>

                <li class="side-nav-item">

                    <a
                        class="side-nav-link"
                        href="#opportunities"
                        data-section-link="opportunities"
                    >

                        <span class="side-nav-index">
                            04
                        </span>

                        <span>
                            Opportunities
                        </span>

                    </a>

                </li>

            </ul>

        </nav>

    </aside>

    <main class="main-content">

        <section
            class="hero section section-xl"
            id="overview"
            data-section="overview"
        >

            <div class="hero-content">

                <span class="eyebrow">
                    CyberNexus PH
                </span>

                <h1 class="hero-title">
                    Let's
                    <span class="cn-gradient-text">
                        Connect
                    </span>
                </h1>

                <p class="hero-subtitle">
                    Use this page to send a professional message,
                    discuss an IT project, ask about technical work,
                    or explore potential opportunities.
                </p>

                <div class="hero-actions">

                    <a
                        class="button button-primary"
                        href="#contact-form"
                    >
                        Send a Message
                    </a>

                    <a
                        class="button button-secondary"
                        href="projects.html"
                    >
                        View Projects
                    </a>

                </div>

            </div>

            <div
                class="hero-visual"
                aria-hidden="true"
            >

                <div class="hero-orb hero-orb-green"></div>
                <div class="hero-orb hero-orb-cyan"></div>
                <div class="hero-orb hero-orb-purple"></div>

                <div class="hero-grid"></div>

                <div class="hero-terminal">

                    <div class="terminal-header">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="terminal-body">

                        <span class="terminal-line">

                            <span class="cn-text-green">
                                $
                            </span>

                            contact --open

                        </span>

                        <span class="terminal-line">

                            <span class="cn-text-cyan">
                                channel:
                            </span>

                            available

                        </span>

                        <span class="terminal-line">

                            <span class="cn-text-purple">
                                response:
                            </span>

                            professional

                        </span>

                        <span class="terminal-line">

                            <span class="cn-text-green">
                                status:
                            </span>

                            ready

                        </span>

                    </div>

                </div>

            </div>

        </section>

        <section
            class="section section-lg"
            id="contact-form"
            data-section="contact-form"
        >

            <div class="section-header">

                <span class="eyebrow">
                    02 / Message
                </span>

                <h2 class="section-title">
                    Send a Message
                </h2>

                <p class="section-subtitle">
                    Complete the form below with your message or
                    inquiry.
                </p>

            </div>

            <form
                class="form card"
                method="post"
                action="/api/contact"
                data-frontend-form="contact"
                novalidate
            >

                <div class="grid-2">

                    <div class="form-field">

                        <label for="contact-name">
                            Name
                        </label>

                        <input
                            id="contact-name"
                            name="name"
                            type="text"
                            autocomplete="name"
                            placeholder="Enter your name"
                            required
                        >

                    </div>

                    <div class="form-field">

                        <label for="contact-email">
                            Email
                        </label>

                        <input
                            id="contact-email"
                            name="email"
                            type="email"
                            autocomplete="email"
                            placeholder="Enter your email address"
                            required
                        >

                    </div>

                </div>

                <div class="form-field">

                    <label for="contact-subject">
                        Subject
                    </label>

                    <input
                        id="contact-subject"
                        name="subject"
                        type="text"
                        placeholder="Enter the subject of your message"
                        required
                    >

                </div>

                <div class="form-field">

                    <label for="contact-message">
                        Message
                    </label>

                    <textarea
                        id="contact-message"
                        name="message"
                        rows="8"
                        placeholder="Write your message, project inquiry, technical question, or professional request here."
                        required
                    ></textarea>

                </div>

                <div class="form-actions">

                    <button
                        class="button button-primary"
                        type="submit"
                    >
                        Send Message
                    </button>

                    <button
                        class="button button-secondary"
                        type="reset"
                    >
                        Clear
                    </button>

                </div>

                <div
                    class="alert"
                    data-contact-status
                    role="status"
                    aria-live="polite"
                    hidden
                ></div>

            </form>

        </section>

        <section
            class="section section-lg"
            id="channels"
            data-section="channels"
        >

            <div class="section-header">

                <span class="eyebrow">
                    03 / Channels
                </span>

                <h2 class="section-title">
                    Contact Channels
                </h2>

                <p class="section-subtitle">
                    Professional communication channels for
                    project discussions, technical work, and
                    career opportunities.
                </p>

            </div>

            <div class="grid-3">

                <article class="feature-card">

                    <span
                        class="feature-icon"
                        aria-hidden="true"
                    >
                        @
                    </span>

                    <h3 class="feature-title">
                        Email
                    </h3>

                    <p class="feature-text">
                        Use email for direct professional
                        communication and project inquiries.
                    </p>

                    <a
                        class="tag"
                        href="mailto:cybernexus.eit@gmail.com"
                    >
                        cybernexus.eit@gmail.com
                    </a>

                </article>

                <article class="feature-card">

                    <span
                        class="feature-icon"
                        aria-hidden="true"
                    >
                        GH
                    </span>

                    <h3 class="feature-title">
                        GitHub
                    </h3>

                    <p class="feature-text">
                        Explore technical projects, source code,
                        and development work.
                    </p>

                    <a
                        class="tag"
                        href="https://github.com/CyberNexus-EIT"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        GitHub Profile
                    </a>

                </article>

                <article class="feature-card">

                    <span
                        class="feature-icon"
                        aria-hidden="true"
                    >
                        IN
                    </span>

                    <h3 class="feature-title">
                        LinkedIn
                    </h3>

                    <p class="feature-text">
                        Connect for career opportunities,
                        professional networking, and technical
                        collaboration.
                    </p>

                    <a
                        class="tag"
                        href="https://www.linkedin.com/in/mark-pangilinan-192053293"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        LinkedIn Profile
                    </a>

                </article>

            </div>

        </section>

        <section
            class="section section-lg"
            id="opportunities"
            data-section="opportunities"
        >

            <div class="curved-panel">

                <div class="section-header">

                    <span class="eyebrow">
                        04 / Opportunities
                    </span>

                    <h2 class="section-title">
                        Professional IT &amp; Security Engineering
                    </h2>

                    <p class="section-subtitle">
                        For project discussions, technical
                        collaboration, IT opportunities, and
                        professional inquiries.
                    </p>

                </div>

                <div class="hero-actions">

                    <a
                        class="button button-primary"
                        href="projects.html"
                    >
                        Explore Projects
                    </a>

                    <a
                        class="button button-secondary"
                        href="experience.html"
                    >
                        View Experience
                    </a>

                </div>

            </div>

        </section>

    </main>

</div>

<footer class="site-footer">

    <div class="footer-inner">

        <div class="footer-brand">

            <strong>
                CyberNexus PH
            </strong>

            <span>
                CyberNexus IT Portfolio Platform
            </span>

        </div>

        <div class="footer-meta">

            <span>
                DevSecOps Engineer: Mark C. Pangilinan
            </span>

        </div>

        <nav
            class="footer-nav"
            aria-label="Footer navigation"
        >

            <div class="footer-links">

                <a href="privacy.html">
                    Privacy
                </a>

                <a href="terms.html">
                    Terms
                </a>

                <a href="portfolio.html">
                    Portfolio
                </a>

            </div>

        </nav>

    </div>

</footer>

<script src="js/state.js" defer></script>
<script src="js/http-user.js" defer></script>
<script src="js/api-user.js" defer></script>
<script src="js/auth-user.js" defer></script>
<script src="js/account-user.js" defer></script>
<script src="js/web-app.js" defer></script>
<script src="js/chat.js" defer></script>
<script src="js/voice.js" defer></script>

</body></html>
